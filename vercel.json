{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/karan",
      "dest": "api/index.py"
    },
    {
      "src": "/friday",
      "dest": "api/index.py"
    },
    {
      "src": "/status",
      "dest": "api/index.py"
    },
    {
      "src": "/auth/gmail",
      "dest": "api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
